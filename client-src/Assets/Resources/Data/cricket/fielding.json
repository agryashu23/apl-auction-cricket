{
  "conventions": {
    "rig": "Mixamo skeleton from Sitting_Talking.fbx (65 bones, mixamorig: names), skeleton only, 30 fps, frames start at 1",
    "facing": "on frame 1 the fielder faces the rig's forward direction (toward the batter / incoming ball); left/right are the fielder's own",
    "event_frame": "1-based frame of the catch / ball collected / release; ball_at_event_m is where the ball is at that frame, relative to the start position on the ground (forward / left / up)",
    "ball": "attach the ball to mixamorig:RightHand from the event frame (catches end with both hands holding it at the chest); for throws, keep it on RightHand until the release frame",
    "root_motion": "locomotion loops are in place (move the character in code at speed_m_s); every other clip carries its travel in the hips (end_position_m)",
    "chaining": "catches and stops end standing with the ball at the chest - the same pose throw_18_overarm_throw starts from; runs/stops end in the ready position",
    "gait": "all running/walking is generated per frame: planted feet do not slide, swing feet follow a speed-dependent arc, hips ride tall (0.97-1.03 m) and bounce like a real runner; the ready stance is an athletic stance with soft knees"
  },
